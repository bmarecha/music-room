# Copy to .env (never commit .env).

# PostgreSQL
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musicroom

# Backend
SECRET_KEY=change-me

# LAN IP of the machine running docker (reachable from your phone)
HOST_IP=192.168.1.10

# Backend address used by the mobile app
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
